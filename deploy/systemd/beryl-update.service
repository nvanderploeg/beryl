[Unit]
Description=Pull and restart beryl if a new image is published
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/beryl
ExecStart=/usr/bin/docker compose -p beryl --env-file deploy/beryl.env -f deploy/compose.prod.yml pull app
ExecStart=/usr/bin/docker compose -p beryl --env-file deploy/beryl.env -f deploy/compose.prod.yml up -d
ExecStartPost=/usr/bin/docker image prune -f --filter label=org.opencontainers.image.source=https://github.com/nvanderploeg/beryl

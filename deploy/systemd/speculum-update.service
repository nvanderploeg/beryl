[Unit]
Description=Pull and restart speculum if a new image is published
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/speculum
ExecStart=/usr/bin/docker compose -p speculum --env-file deploy/speculum.env -f deploy/compose.prod.yml pull app
ExecStart=/usr/bin/docker compose -p speculum --env-file deploy/speculum.env -f deploy/compose.prod.yml up -d
ExecStartPost=/usr/bin/docker image prune -f --filter label=org.opencontainers.image.source=https://github.com/nvanderploeg/speculum

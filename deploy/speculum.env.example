# Copy to deploy/speculum.env and chmod 600.

# Hex only: it is spliced into DATABASE_URL. openssl rand -hex 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

ORIGIN=https://speculum.example.com

SPECULUM_IDLE_MS=14400000
SPECULUM_HEARTBEAT_MS=25000
SPECULUM_WRITES_PER_WINDOW=300
SPECULUM_WRITE_WINDOW_MS=300000

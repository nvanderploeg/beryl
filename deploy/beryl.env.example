# Copy to deploy/beryl.env and chmod 600.

# Postgres the app connects to. Hex password only (spliced unencoded); verify-full needs the CA
# to be trusted, or add sslrootcert=/path/ca.pem. Run one app replica only.
DATABASE_URL=postgres://beryl:PASSWORD@pg.example.com:5432/beryl?sslmode=verify-full

ORIGIN=https://beryl.example.com

# Enables /admin (export, import, delete). Empty keeps it off (404). openssl rand -hex 24
ADMIN_TOKEN=

# Firebase Auth sign-in; leave empty to keep it off. The service account is a secret:
# keep the file outside the repo, chmod 644 or owned by uid 1000, and set its host path here.
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=
# Cookie Domain shared with sagas and chronicle, e.g. .nanzero.com. Empty: host-only.
AUTH_COOKIE_DOMAIN=
FIREBASE_WEB_API_KEY=
# Defaults: runestone-d3a35.firebaseapp.com and runestone-d3a35.
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

BERYL_IDLE_MS=14400000
BERYL_HEARTBEAT_MS=25000
BERYL_WRITES_PER_WINDOW=300
BERYL_WRITE_WINDOW_MS=300000

